# Copy to .env and adjust. No secrets are required for local development.
EMOJILENS_DATABASE_URL=sqlite:///./var/emojilens.db
EMOJILENS_MAX_INPUT_CODEPOINTS=20000
EMOJILENS_LOG_LEVEL=INFO
# JSON list of allowed browser origins for the local web app
EMOJILENS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
